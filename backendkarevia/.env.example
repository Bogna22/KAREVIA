APP_NAME=KAREVIA
APP_ENV=local
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=true
APP_URL=http://localhost:8000

# URL de ton frontend React
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─── BASE DE DONNÉES (MySQL) ───────────────────────────────────
# Tu n'as PAS besoin d'ouvrir SQL manuellement.
# Laravel crée les tables automatiquement avec : php artisan migrate
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=karevia_db       # Nom de ta base (crée-la une seule fois dans phpMyAdmin ou MySQL)
DB_USERNAME=root
DB_PASSWORD=                  # Ton mot de passe MySQL

# ─── AUTHENTIFICATION ──────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# ─── STRIPE (paiement) ─────────────────────────────────────────
# Crée un compte sur stripe.com → Dashboard → Développeurs → Clés API
STRIPE_KEY=pk_test_XXXXXXXXXXXXXXXXXX
STRIPE_SECRET=sk_test_XXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXX

# ─── STORAGE (upload fichiers) ─────────────────────────────────
FILESYSTEM_DISK=public

# ─── MAIL (optionnel pour l'instant) ──────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@karevia.com"
MAIL_FROM_NAME="KAREVIA"

# ─── QUEUE ────────────────────────────────────────────────────
QUEUE_CONNECTION=sync
